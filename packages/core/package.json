{
  "name": "@basis/core",
  "version": "0.1.0",
  "description": "Typed plugin composition, scoped lifecycles, hooks, events, and supervised reloads",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
