    "test": "bun test ./tests",
    "bench": "bun run ./bench/core.ts"
  },
  "dependencies": {
    "effect": "3.22.2"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "typescript": "5.9.3"
  }
}
