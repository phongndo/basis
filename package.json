{
  "name": "basis",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @basis/core build",
    "check": "pnpm build && node scripts/check-boundaries.ts && pnpm lint && pnpm format:check && pnpm -r --workspace-concurrency=4 check",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "test": "pnpm -r --workspace-concurrency=4 test",
    "start": "pnpm --filter @basis/web build && pnpm --filter @basis/host start",
    "basis": "node --conditions=source apps/cli/src/main.ts",
    "dev:web": "pnpm --filter @basis/web dev",
    "harness:check": "pnpm -r --filter './plugins/**' --filter './apps/**' --filter @basis/contracts --filter @basis/client check",
    "example": "pnpm build && node packages/core/examples/hello.ts",
    "package:check": "node scripts/check-package.ts",
    "browser:check": "node scripts/check-package.ts --browser",
    "core:check": "pnpm --filter @basis/core check",
    "core:test": "pnpm --filter @basis/core test",
    "core:bench": "pnpm --filter @basis/core bench",
    "core:stress": "node --expose-gc packages/core/bench/workload.ts",
    "perf:check": "pnpm build && pnpm core:bench && pnpm core:stress"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "oxfmt": "0.70.0",
    "oxlint": "1.85.0",
    "playwright": "1.63.0"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=12"
  }
}
