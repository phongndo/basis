{
  "name": "basis",
  "private": true,
  "workspaces": ["packages/core"],
  "scripts": {
    "build": "bun run --cwd packages/core build",
    "check": "bun run build && bun run core:check",
    "test": "bun run core:test",
    "example": "bun run build && bun run packages/core/examples/hello.ts",
    "package:check": "bun run scripts/check-package.ts",
    "core:check": "bun run --cwd packages/core check",
    "core:test": "bun run --cwd packages/core test",
    "core:bench": "bun run --cwd packages/core bench"
  }
}
